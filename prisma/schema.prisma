datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  // Relations
  cashierOrders    Order[]           @relation("CashierOrders")
  shifts           Shift[]
  auditLogs        AuditLog[]
  inventoryLedgers InventoryLedger[] @relation("LedgerCreator")

  @@index([roleId])
}

model Role {
  id          String       @id @default(uuid())
  name        RoleName     @unique
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz
}

enum RoleName {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_STAFF
}

model Permission {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. product:read
  name      String
  roles     Role[]
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  barcode       String?  @unique
  name          String
  description   String?
  price         Decimal  @db.Decimal(12, 2)
  cost          Decimal  @db.Decimal(12, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id])
  hasVariants   Boolean  @default(false)
  isActive      Boolean  @default(true)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  // Relations
  variants         ProductVariant[]
  orderItems       OrderItem[]
  inventoryLedgers InventoryLedger[]

  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  sku           String   @unique
  barcode       String?  @unique
  name          String
  price         Decimal  @db.Decimal(12, 2)
  cost          Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  orderItems      OrderItem[]
  InventoryLedger InventoryLedger[]

  @@index([productId])
}

model Order {
  id              String            @id @default(uuid())
  orderNumber     String            @unique
  status          OrderStatus       @default(DRAFT)
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  cashierId       String?
  cashier         User?             @relation("CashierOrders", fields: [cashierId], references: [id])
  shiftId         String?
  shift           Shift?            @relation(fields: [shiftId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  subtotal        Decimal           @db.Decimal(12, 2)
  discount        Decimal           @default(0) @db.Decimal(12, 2)
  tax             Decimal           @default(0) @db.Decimal(12, 2)
  total           Decimal           @db.Decimal(12, 2)
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz
  InventoryLedger InventoryLedger[]
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  productId String?
  product   Product?        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  sku       String
  name      String
  quantity  Int
  price     Decimal         @db.Decimal(12, 2)
  cost      Decimal         @db.Decimal(12, 2)
  taxRate   Decimal         @db.Decimal(5, 2)
  taxAmount Decimal         @db.Decimal(12, 2)
  lineTotal Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now()) @db.Timestamptz
  updatedAt DateTime        @updatedAt @db.Timestamptz

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String?
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  @@index([orderId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  QR_CODE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model InventoryLedger {
  id             String          @id @default(uuid())
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id])
  type           InventoryType
  quantity       Int // signed: positive = increase, negative = decrease
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  reference      String? // e.g. order number, adjustment id
  createdAt      DateTime        @default(now()) @db.Timestamptz
  createdById    String?
  createdBy      User?           @relation("LedgerCreator", fields: [createdById], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
}

enum InventoryType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  VOID
}

model Shift {
  id             String      @id @default(uuid())
  cashierId      String
  cashier        User        @relation(fields: [cashierId], references: [id])
  status         ShiftStatus @default(OPEN)
  openingCash    Decimal     @db.Decimal(12, 2)
  closingCash    Decimal?    @db.Decimal(12, 2)
  cashDifference Decimal?    @db.Decimal(12, 2)
  totalSales     Decimal?    @db.Decimal(12, 2)
  cashSales      Decimal?    @db.Decimal(12, 2)
  nonCashSales   Decimal?    @db.Decimal(12, 2)
  openedAt       DateTime    @default(now()) @db.Timestamptz
  closedAt       DateTime?
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  orders Order[]

  @@index([cashierId])
}

enum ShiftStatus {
  OPEN
  ACTIVE
  CLOSED
}

model Customer {
  id         String   @id @default(uuid())
  name       String
  email      String?  @unique
  phone      String?
  address    Json?
  totalSpent Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  orders Order[]
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String?
  address   Json?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([entity, createdAt])
}
